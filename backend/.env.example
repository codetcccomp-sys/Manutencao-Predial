# Banco em desenvolvimento: variáveis discretas, sem SSL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smp
DB_USER=smp_user
DB_PASSWORD=troque_esta_senha

# Em produção, no lugar das variáveis acima, use a string do pooler do
# Supabase (modo transação, porta 6543). O db.js força SSL nesse caminho.
# DATABASE_URL=postgresql://usuario:senha@host:6543/postgres

# Certificado da autoridade que assina o servidor do banco, em PEM.
#
# OBRIGATÓRIO em produção: sem ele a aplicação não sobe. Não é zelo excessivo.
# A conexão rodava com `rejectUnauthorized: false` — criptografada e NÃO
# autenticada, que é o que a documentação do Supabase chama de `sslmode=require`:
# "sempre usa SSL, mas não verifica o certificado do servidor nem o hostname".
# Quem conseguisse se colocar entre a Vercel e o Supabase apresentaria um
# certificado qualquer e seria aceito, lendo toda consulta e todo hash de senha.
#
# Falhar na subida é deliberado: a alternativa é voltar ao modo fraco em
# silêncio, e essa é exatamente a falha que ninguém percebe até ser tarde.
#
# Baixe em: Dashboard → Project Settings → Database → SSL Configuration.
# Opcional: sem esta variável, vale o arquivo backend/database/supabase-ca.crt,
# que já está no repositório. Use-a só para trocar o certificado sem novo
# deploy (esta raiz expira em 2031).
#
# Cole o PEM inteiro, das linhas BEGIN a END. Com quebras de linha de verdade
# ou numa linha só com \n escrito por extenso — as duas formas funcionam, e um
# valor que não for certificado impede a subida com uma mensagem que diz isso,
# em vez de derrubar cada consulta ao banco sem dizer por quê.
# O certificado de uma CA é público — ele existe para ser distribuído.
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Assinatura dos tokens. Trocar este valor invalida todas as sessões ativas.
JWT_SECRET=troque_por_um_segredo_forte_e_aleatorio
JWT_EXPIRES_IN=8h

PORT=3333
NODE_ENV=development

# E-mail das notificações. Sem SMTP_HOST e SMTP_PORT o envio vira registro em
# log e o resto do sistema segue funcionando normalmente.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_REMETENTE=

# Segredo do agendador externo que dispara a varredura de atrasos (RF08).
# Sem ele a rota /tarefas responde 503 em vez de ficar aberta: falha fechada.
# Gere um valor aleatório longo, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Endereço do APP — não o da API. É para cá que aponta o link de redefinição
# de senha que sai por e-mail: `/redefinir-senha` é rota do React, e não existe
# na API. Front e back são duas aplicações em domínios diferentes, então a API
# não tem como deduzir este endereço a partir da requisição que recebeu.
#
# Sem esta variável, a API só monta o link quando o `Host` da requisição é
# local (desenvolvimento). Em produção sem ela, o e-mail NÃO é enviado e a
# falha vai para o log — porque o `Host` é escolhido por quem faz a
# requisição, e confiar nele mandaria o token da vítima para o endereço de
# quem pediu.
URL_APP=http://localhost:5173

# Fuso usado nas mensagens montadas no servidor (aviso de atraso por e-mail).
# O servidor roda em UTC; sem isso o prazo chega deslocado para quem lê.
FUSO_HORARIO=America/Sao_Paulo
