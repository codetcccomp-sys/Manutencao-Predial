# Banco em desenvolvimento: variáveis discretas, sem SSL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smp
DB_USER=smp_user
DB_PASSWORD=troque_esta_senha

# Em produção, no lugar das variáveis acima, use a string do pooler do
# Supabase (modo transação, porta 6543). O db.js força SSL nesse caminho.
# DATABASE_URL=postgresql://usuario:senha@host:6543/postgres

# Assinatura dos tokens. Trocar este valor invalida todas as sessões ativas.
JWT_SECRET=troque_por_um_segredo_forte_e_aleatorio
JWT_EXPIRES_IN=8h

PORT=3333
NODE_ENV=development

# E-mail das notificações. Sem SMTP_HOST e SMTP_PORT o envio vira registro em
# log e o resto do sistema segue funcionando normalmente.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_REMETENTE=
