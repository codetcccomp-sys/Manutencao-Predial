{
  "name": "smp-backend",
  "version": "1.0.0",
  "description": "API do Sistema de Manutenção Predial",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node database/migrate.js",
    "test": "jest --runInBand",
    "test:paralelo": "jest",
    "test:sla": "jest --runInBand tests/sla.test.js tests/horasUteis.test.js tests/atrasos.test.js"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/tests/apoio/ambiente.js"
    ],
    "globalTeardown": "<rootDir>/tests/apoio/globalTeardown.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.3.2"
  }
}
